# Copy to .env.local (web) / .env (api) and fill in real values.
# Never commit the filled-in files.

# --- Web (Next.js) ---
# Base URL the browser uses to reach the NestJS API.
NEXT_PUBLIC_API_URL=http://localhost:4000

# PostHog analytics. Leave unset to disable instrumentation entirely.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Solana cluster the app operates on: mainnet-beta | devnet | testnet.
# MUST match the network HELIUS_RPC_URL points at. A mismatch means the UI
# advertises one network while transactions execute on another — harmless while
# everything is read-only, dangerous the moment funds move.
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta

# Supabase project URL and anon key. Both are safe in the browser — the anon key
# is constrained by Row Level Security, not by secrecy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# hCaptcha site key. Public by design — it only identifies the widget.
# The matching SECRET goes in the Supabase dashboard (Auth > Bot and Abuse
# Protection) and must never appear in this repo: Supabase verifies the token
# server-side, so our code has no use for it.
# Leave blank to disable the CAPTCHA step locally.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

# --- API (NestJS) ---
PORT=4000

# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000

# BYPASSES Row Level Security. Server-side only — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Legacy symmetric secret. NOT used to verify access tokens — Supabase signs
# those with rotating asymmetric keys, and the API verifies them against
# /auth/v1/.well-known/jwks.json. Kept only for tooling that still expects it.
SUPABASE_JWT_SECRET=

# Pooled connection for the running service. Supabase's transaction pooler does
# not support prepared statements, which is why the client sets prepare: false.
DATABASE_URL=
# Unpooled connection. drizzle-kit needs this — DDL cannot run over the pooler.
DIRECT_URL=

REDIS_URL=redis://localhost:6379

# --- External services (server-side only, never expose with NEXT_PUBLIC_) ---
OPENAI_API_KEY=
HELIUS_RPC_URL=
BAGS_API_KEY=
X_API_KEY=
GITHUB_TOKEN=
BIRDEYE_API_KEY=

# Rate limiting. Optional — defaults are 30 per 10s (burst) and 200 per 60s
# (sustained), keyed on client IP.
THROTTLE_BURST_LIMIT=
THROTTLE_BURST_TTL_MS=
THROTTLE_SUSTAINED_LIMIT=
THROTTLE_SUSTAINED_TTL_MS=
