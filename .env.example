# Copy to .env.local (web) / .env (api) and fill in real values.
# Never commit the filled-in files.

# --- Web (Next.js) ---
# Base URL the browser uses to reach the NestJS API.
NEXT_PUBLIC_API_URL=http://localhost:4000

# PostHog analytics. Leave unset to disable instrumentation entirely.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Solana cluster the wallet adapter connects to: mainnet-beta | devnet | testnet
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Supabase project URL and anon key. Both are safe in the browser — the anon key
# is constrained by Row Level Security, not by secrecy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- API (NestJS) ---
PORT=4000

# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000

# BYPASSES Row Level Security. Server-side only — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Verifies user JWTs arriving from the web app.
SUPABASE_JWT_SECRET=

# Pooled connection for the running service. Supabase's transaction pooler does
# not support prepared statements, which is why the client sets prepare: false.
DATABASE_URL=
# Unpooled connection. drizzle-kit needs this — DDL cannot run over the pooler.
DIRECT_URL=

REDIS_URL=redis://localhost:6379

# --- External services (server-side only, never expose with NEXT_PUBLIC_) ---
OPENAI_API_KEY=
HELIUS_RPC_URL=
BAGS_API_KEY=
X_API_KEY=
GITHUB_TOKEN=
BIRDEYE_API_KEY=
